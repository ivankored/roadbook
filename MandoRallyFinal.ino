<script>
// Catalogo de teclas asignables. Las de grupo "musica" son las que hemos
// comprobado que siempre funcionan por Bluetooth; las de "teclado" pueden
// no funcionar en todos los dispositivos.
const KEY_CATALOG = [
  {v:0,  label:"(ninguna)", group:"otro"},
  {v:1,  label:"Play / Pausa", group:"musica"},
  {v:2,  label:"Volumen +", group:"musica"},
  {v:3,  label:"Volumen -", group:"musica"},
  {v:4,  label:"Siguiente cancion", group:"musica"},
  {v:5,  label:"Cancion anterior", group:"musica"},
  {v:6,  label:"Silencio (mute)", group:"musica"},
  {v:7,  label:"Stop", group:"musica"},
  {v:50, label:"Enter", group:"teclado"},
  {v:51, label:"Espacio", group:"teclado"},
  {v:52, label:"Escape", group:"teclado"},
  {v:53, label:"Retroceso", group:"teclado"},
  {v:54, label:"Tab", group:"teclado"},
  {v:55, label:"Flecha arriba", group:"teclado"},
  {v:56, label:"Flecha abajo", group:"teclado"},
  {v:57, label:"Flecha izquierda", group:"teclado"},
  {v:58, label:"Flecha derecha", group:"teclado"},
];
for(let i=0;i<26;i++){
  KEY_CATALOG.push({v:10+i, label:"Letra "+String.fromCharCode(65+i), group:"teclado"});
}
for(let i=0;i<10;i++){
  KEY_CATALOG.push({v:40+i, label:"Numero "+i, group:"teclado"});
}
const GROUP_LABELS = {musica:"Multimedia (recomendado)", teclado:"Teclado", otro:""};

const PHYS_LABELS = ["Boton 1 (arriba)","Boton 2","Boton 3","Palanca abajo","Palanca arriba"];
const NUM_PERFILES = 3;

let perfiles = [];      // [{nombre, teclas:[..5..]}, ...] x3
let perfilActivoServidor = 0;
let perfilSeleccionado = 0;

function toast(msg, isErr){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.background = isErr ? 'rgba(255,59,48,0.95)' : 'rgba(28,28,30,0.92)';
  t.classList.add('show');
  clearTimeout(toast._t);
  toast._t = setTimeout(()=>t.classList.remove('show'), 2200);
}

function buildProfileTabs(){
  const cont = document.getElementById('profileTabs');
  cont.innerHTML = '';
  for(let p=0;p<NUM_PERFILES;p++){
    const tab = document.createElement('div');
    tab.className = 'profile-tab' + (p===perfilSeleccionado ? ' active' : '');
    tab.textContent = perfiles[p].nombre + (p===perfilActivoServidor ? ' ●' : '');
    tab.addEventListener('click', ()=>seleccionarPerfil(p));
    cont.appendChild(tab);
  }
}

function seleccionarPerfil(p){
  perfilSeleccionado = p;
  document.getElementById('profileNameInput').value = perfiles[p].nombre;
  buildProfileTabs();
  buildSlots();
}

function buildSlots(){
  const cont = document.getElementById('slots');
  cont.innerHTML = '';
  const teclas = perfiles[perfilSeleccionado].teclas;
  for(let i=0;i<5;i++){
    const row = document.createElement('div');
    row.className = 'slot-row';
    const name = document.createElement('div');
    name.className = 'name';
    name.textContent = PHYS_LABELS[i];
    const sel = document.createElement('select');
    sel.id = 'slot'+i;
    let grupoActual = null;
    KEY_CATALOG.forEach(o=>{
      if(o.group !== grupoActual && o.group !== 'otro'){
        grupoActual = o.group;
        const og = document.createElement('optgroup');
        og.label = GROUP_LABELS[o.group];
        og.dataset.group = o.group;
        sel.appendChild(og);
      }
      const opt = document.createElement('option');
      opt.value = o.v; opt.textContent = o.label;
      (sel.querySelector('optgroup[data-group="'+o.group+'"]') || sel).appendChild(opt);
    });
    sel.value = teclas[i];
    sel.addEventListener('change', ()=>{ teclas[i] = parseInt(sel.value); });
    row.appendChild(name); row.appendChild(sel);
    cont.appendChild(row);
  }
}

async function cargarPerfiles(){
  try{
    const res = await fetch('/api/profiles');
    const text = await res.text();
    const p = new URLSearchParams(text);
    perfilActivoServidor = parseInt(p.get('active')) || 0;
    perfiles = [];
    for(let n=0;n<NUM_PERFILES;n++){
      const nombre = decodeURIComponent((p.get('p'+n+'nom')||('Perfil '+(n+1))).replace(/\+/g,' '));
      const teclas = [];
      for(let i=0;i<5;i++){
        teclas.push(parseInt(p.get('p'+n+'_'+i)) || 0);
      }
      perfiles.push({nombre, teclas});
    }
    perfilSeleccionado = perfilActivoServidor;
    document.getElementById('profileNameInput').value = perfiles[perfilSeleccionado].nombre;
    buildProfileTabs();
    buildSlots();
  }catch(e){
    toast('No se pudo cargar la configuracion', true);
  }
}

document.getElementById('saveProfileBtn').addEventListener('click', async ()=>{
  const nombre = document.getElementById('profileNameInput').value.trim() || ('Perfil '+(perfilSeleccionado+1));
  perfiles[perfilSeleccionado].nombre = nombre;
  const teclas = perfiles[perfilSeleccionado].teclas;
  const body = 'perfil='+perfilSeleccionado+'&nombre='+encodeURIComponent(nombre)+
    '&k0='+teclas[0]+'&k1='+teclas[1]+'&k2='+teclas[2]+'&k3='+teclas[3]+'&k4='+teclas[4];
  try{
    const res = await fetch('/api/profile', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body
    });
    if(res.ok){ toast('Perfil guardado'); buildProfileTabs(); } else { toast('Error al guardar', true); }
  }catch(e){ toast('Sin conexion con el mando', true); }
});

document.getElementById('useProfileBtn').addEventListener('click', async ()=>{
  try{
    const res = await fetch('/api/activeprofile', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body: 'perfil='+perfilSeleccionado
    });
    if(res.ok){
      perfilActivoServidor = perfilSeleccionado;
      buildProfileTabs();
      toast('Perfil activo: ' + perfiles[perfilSeleccionado].nombre);
    } else { toast('Error al activar', true); }
  }catch(e){ toast('Sin conexion con el mando', true); }
});

async function cargarNombre(){
  try{
    const res = await fetch('/api/name');
    const text = await res.text();
    document.getElementById('nameInput').value = text;
  }catch(e){}
}

document.getElementById('saveNameBtn').addEventListener('click', async ()=>{
  const val = document.getElementById('nameInput').value.trim();
  if(!val){ toast('Escribe un nombre', true); return; }
  toast('Guardando y reiniciando...');
  try{
    await fetch('/api/name', {
      method:'POST',
      headers:{'Content-Type':'application/x-www-form-urlencoded'},
      body: 'name=' + encodeURIComponent(val)
    });
  }catch(e){}
});

const dropzone = document.getElementById('dropzone');
const fileInput = document.getElementById('fileInput');
const uploadBtn = document.getElementById('uploadBtn');
const filenameEl = document.getElementById('filename');
let selectedFile = null;

dropzone.addEventListener('click', ()=>fileInput.click());
['dragover','dragenter'].forEach(ev=>dropzone.addEventListener(ev, e=>{e.preventDefault(); dropzone.classList.add('drag');}));
['dragleave','drop'].forEach(ev=>dropzone.addEventListener(ev, e=>{e.preventDefault(); dropzone.classList.remove('drag');}));
dropzone.addEventListener('drop', e=>{
  if(e.dataTransfer.files.length){ setFile(e.dataTransfer.files[0]); }
});
fileInput.addEventListener('change', ()=>{
  if(fileInput.files.length){ setFile(fileInput.files[0]); }
});
function setFile(f){
  selectedFile = f;
  filenameEl.textContent = f.name;
  uploadBtn.disabled = false;
}

uploadBtn.addEventListener('click', ()=>{
  if(!selectedFile) return;
  const statusEl = document.getElementById('otaStatus');
  const wrap = document.getElementById('progressWrap');
  const bar = document.getElementById('progressBar');
  statusEl.textContent = ''; statusEl.className = 'status';
  wrap.style.display = 'block'; bar.style.width = '0%';
  uploadBtn.disabled = true;

  const fd = new FormData();
  fd.append('update', selectedFile);
  const xhr = new XMLHttpRequest();
  xhr.open('POST', '/update', true);
  xhr.upload.onprogress = (e)=>{
    if(e.lengthComputable){ bar.style.width = Math.round(e.loaded/e.total*100)+'%'; }
  };
  xhr.onload = ()=>{
    if(xhr.status === 200 && !xhr.responseText.toLowerCase().includes('error')){
      statusEl.textContent = 'Actualizado. Reiniciando...';
      statusEl.classList.add('ok');
    } else {
      statusEl.textContent = 'Error al actualizar: '+xhr.responseText;
      statusEl.classList.add('err');
      uploadBtn.disabled = false;
    }
  };
  xhr.onerror = ()=>{
    statusEl.textContent = 'Fallo de conexion durante la subida';
    statusEl.classList.add('err');
    uploadBtn.disabled = false;
  };
  xhr.send(fd);
});

document.getElementById('restartBtn').addEventListener('click', async ()=>{
  toast('Reiniciando mando...');
  try{ await fetch('/api/restart', {method:'POST'}); }catch(e){}
});

cargarPerfiles();
cargarNombre();
</script>
</body>
</html>

)HTMLPAGE";

// ======================= UTILIDADES DE CONFIG =======================

// Codifica un texto para poder mandarlo dentro de una respuesta
// application/x-www-form-urlencoded (usado para los nombres de perfil,
// que pueden llevar espacios u otros caracteres).
String urlEncode(const String& str) {
  String encoded = "";
  char buf[4];
  for (size_t i = 0; i < str.length(); i++) {
    char c = str.charAt(i);
    if (isalnum((unsigned char)c) || c == '-' || c == '_' || c == '.' || c == '~') {
      encoded += c;
    } else {
      sprintf(buf, "%%%02X", (unsigned char)c);
      encoded += buf;
    }
  }
  return encoded;
}

void cargarConfig() {
  prefs.begin("mando", false);
  perfilActivo = prefs.getInt("perfilActivo", 0);
  if (perfilActivo < 0 || perfilActivo >= NUM_PERFILES) perfilActivo = 0;
  for (int p = 0; p < NUM_PERFILES; p++) {
    perfilNombre[p] = prefs.getString(("pnom" + String(p)).c_str(), "Perfil " + String(p + 1));
    for (int i = 0; i < 5; i++) {
      int porDefecto = i + 1; // 1..5 = mapeo clasico de musica
      botonKeyId[p][i] = prefs.getInt(("pk" + String(p) + "_" + String(i)).c_str(), porDefecto);
    }
  }
  btDeviceName = prefs.getString("btName", "Mando Rally Final");
  prefs.end();
}

// Guarda un unico perfil (nombre + 5 teclas). No toca los otros perfiles.
void guardarPerfil(int p) {
  prefs.begin("mando", false);
  prefs.putString(("pnom" + String(p)).c_str(), perfilNombre[p]);
  for (int i = 0; i < 5; i++) {
    prefs.putInt(("pk" + String(p) + "_" + String(i)).c_str(), botonKeyId[p][i]);
  }
  prefs.end();
}

void guardarPerfilActivo() {
  prefs.begin("mando", false);
  prefs.putInt("perfilActivo", perfilActivo);
  prefs.end();
}

// ======================= CATALOGO DE TECLAS =======================
// id 0        = ninguna accion
// id 1-7      = multimedia (usan el usage page "Consumer Control": son las
//               que hemos comprobado que SIEMPRE funcionan por Bluetooth)
// id 10-35    = letras a-z
// id 40-49    = digitos 0-9
// id 50-58    = teclas especiales de teclado normal (Enter, flechas, etc.)
//               OJO: estas usan el teclado "normal" (usage page Keyboard),
//               que en este mando en concreto hemos comprobado que NO
//               siempre llega al dispositivo (a diferencia de las
//               multimedia). Se dejan disponibles por si en otro
//               dispositivo si funcionan, pero no son fiables al 100%.
void enviarAccion(int keyId) {
  if (keyId == 0) return; // ninguna accion asignada a este boton

  if (keyId >= 10 && keyId <= 35) {
    bleKeyboard->write((char)('a' + (keyId - 10)));
    delay(60);
    return;
  }
  if (keyId >= 40 && keyId <= 49) {
    bleKeyboard->write((char)('0' + (keyId - 40)));
    delay(60);
    return;
  }

  switch (keyId) {
    case 1: bleKeyboard->write(KEY_MEDIA_PLAY_PAUSE); break;
    case 2: bleKeyboard->write(KEY_MEDIA_VOLUME_UP); break;
    case 3: bleKeyboard->write(KEY_MEDIA_VOLUME_DOWN); break;
    case 4: bleKeyboard->write(KEY_MEDIA_NEXT_TRACK); break;
    case 5: bleKeyboard->write(KEY_MEDIA_PREVIOUS_TRACK); break;
    case 6: bleKeyboard->write(KEY_MEDIA_MUTE); break;
    case 7: bleKeyboard->write(KEY_MEDIA_STOP); break;
    case 50: bleKeyboard->write(KEY_RETURN); break;
    case 51: bleKeyboard->write(' '); break;
    case 52: bleKeyboard->write(KEY_ESC); break;
    case 53: bleKeyboard->write(KEY_BACKSPACE); break;
    case 54: bleKeyboard->write(KEY_TAB); break;
    case 55: bleKeyboard->write(KEY_UP_ARROW); break;
    case 56: bleKeyboard->write(KEY_DOWN_ARROW); break;
    case 57: bleKeyboard->write(KEY_LEFT_ARROW); break;
    case 58: bleKeyboard->write(KEY_RIGHT_ARROW); break;
  }
  delay(60);
}

// ======================= MODO ACTUALIZACION (WIFI + WEB) =======================

void iniciarModoOTA() {
  Serial.println(">>> Entrando en MODO ACTUALIZACION (WiFi) <<<");
  modoOtaActivo = true;
  otaModoInicio = millis();

  btStop();  // Apaga el Bluetooth por completo para liberar la radio para el WiFi
  delay(200);

  WiFi.mode(WIFI_AP);
  bool apOk = WiFi.softAP(OTA_SSID, OTA_PASS);
  WiFi.setTxPower(WIFI_POWER_19_5dBm); // potencia maxima permitida, mas alcance
  Serial.print("Punto de acceso creado: ");
  Serial.println(apOk ? "SI" : "NO (fallo)");
  Serial.print("Red WiFi creada: ");
  Serial.println(OTA_SSID);
  Serial.print("Abre en el navegador: http://");
  Serial.println(WiFi.softAPIP());

  // --- Pagina principal ---
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", PAGE_HTML);
  });

  // --- API: leer los 3 perfiles completos + cual esta activo ---
  server.on("/api/profiles", HTTP_GET, []() {
    String resp = "active=" + String(perfilActivo);
    for (int p = 0; p < NUM_PERFILES; p++) {
      resp += "&p" + String(p) + "nom=" + urlEncode(perfilNombre[p]);
      for (int i = 0; i < 5; i++) {
        resp += "&p" + String(p) + "_" + String(i) + "=" + String(botonKeyId[p][i]);
      }
    }
    server.send(200, "text/plain", resp);
  });

  // --- API: guardar UN perfil (nombre + las 5 teclas) ---
  server.on("/api/profile", HTTP_POST, []() {
    if (!server.hasArg("perfil")) {
      server.send(400, "text/plain", "Falta el numero de perfil");
      return;
    }
    int p = server.arg("perfil").toInt();
    if (p < 0 || p >= NUM_PERFILES) {
      server.send(400, "text/plain", "Perfil invalido");
      return;
    }
    int nuevo[5];
    for (int i = 0; i < 5; i++) {
      String key = "k" + String(i);
      if (!server.hasArg(key)) {
        server.send(400, "text/plain", "Falta la tecla del boton " + String(i));
        return;
      }
      nuevo[i] = server.arg(key).toInt();
    }
    String nombre = perfilNombre[p];
    if (server.hasArg("nombre")) {
      nombre = server.arg("nombre");
      nombre.trim();
      if (nombre.length() < 1) nombre = "Perfil " + String(p + 1);
      if (nombre.length() > 20) nombre = nombre.substring(0, 20);
    }
    perfilNombre[p] = nombre;
    for (int i = 0; i < 5; i++) botonKeyId[p][i] = nuevo[i];

    guardarPerfil(p);
    server.send(200, "text/plain", "OK");
  });

  // --- API: cambiar cual es el perfil activo (se aplica al momento) ---
  server.on("/api/activeprofile", HTTP_POST, []() {
    if (!server.hasArg("perfil")) {
      server.send(400, "text/plain", "Falta el numero de perfil");
      return;
    }
    int p = server.arg("perfil").toInt();
    if (p < 0 || p >= NUM_PERFILES) {
      server.send(400, "text/plain", "Perfil invalido");
      return;
    }
    perfilActivo = p;
    guardarPerfilActivo();
    server.send(200, "text/plain", "OK");
  });

  // --- API: leer el nombre Bluetooth actual ---
  server.on("/api/name", HTTP_GET, []() {
    server.send(200, "text/plain", btDeviceName);
  });

  // --- API: cambiar el nombre Bluetooth (requiere reinicio) ---
  server.on("/api/name", HTTP_POST, []() {
    if (!server.hasArg("name")) {
      server.send(400, "text/plain", "Falta el nombre");
      return;
    }
    String nuevo = server.arg("name");
    nuevo.trim();
    if (nuevo.length() < 1 || nuevo.length() > 20) {
      server.send(400, "text/plain", "Nombre invalido (1-20 caracteres)");
      return;
    }
    prefs.begin("mando", false);
    prefs.putString("btName", nuevo);
    prefs.end();
    server.send(200, "text/plain", "OK, reiniciando...");
    delay(400);
    ESP.restart();
  });

  // --- API: reiniciar el mando (vuelve a modo Bluetooth normal) ---
  server.on("/api/restart", HTTP_POST, []() {
    server.send(200, "text/plain", "Reiniciando...");
    delay(300);
    ESP.restart();
  });

  // --- OTA: subida de firmware ---
  server.on("/update", HTTP_POST, []() {
    server.send(200, "text/plain", (Update.hasError()) ? "ERROR al actualizar" : "Actualizacion OK, reiniciando...");
    delay(1000);
    ESP.restart();
  }, []() {
    HTTPUpload& upload = server.upload();
    if (upload.status == UPLOAD_FILE_START) {
      Serial.printf("Actualizando: %s\n", upload.filename.c_str());
      if (!Update.begin(UPDATE_SIZE_UNKNOWN)) {
        Update.printError(Serial);
      }
    } else if (upload.status == UPLOAD_FILE_WRITE) {
      if (Update.write(upload.buf, upload.currentSize) != upload.currentSize) {
        Update.printError(Serial);
      }
    } else if (upload.status == UPLOAD_FILE_END) {
      if (Update.end(true)) {
        Serial.printf("Actualizado correctamente: %u bytes\n", upload.totalSize);
      } else {
        Update.printError(Serial);
      }
    }
  });

  server.begin();
}

// ======================= SETUP =======================

void setup() {
  Serial.begin(115200);
  Serial.println("Iniciando Mando Rally ESP32-C3...");

  for (int i = 0; i < 5; i++) {
    pinMode(PHYSICAL_PINS[i], INPUT_PULLUP);
  }

  cargarConfig();

  // Cambiamos la direccion MAC de Bluetooth para que cualquier movil/tablet
  // que se haya conectado antes a este ESP32 (con firmwares anteriores) lo
  // vea como un dispositivo completamente nuevo, sin ninguna tabla de
  // caracteristicas guardada en cache de versiones anteriores.
  uint8_t nuevaMac[6] = {0x02, 0xAB, 0xCD, 0x12, 0x34, 0x57};
  esp_base_mac_addr_set(nuevaMac);

  bleKeyboard = new BleKeyboard(btDeviceName.c_str(), "PedreiraTech", 100);
  bleKeyboard->begin();

  // Subimos la potencia de emision del Bluetooth al maximo permitido, para
  // mas alcance y una conexion mas estable (menos cortes por señal debil).
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_DEFAULT, ESP_PWR_LVL_P9);
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_ADV, ESP_PWR_LVL_P9);
  esp_ble_tx_power_set(ESP_BLE_PWR_TYPE_CONN_HDL0, ESP_PWR_LVL_P9);

  esp_ble_auth_req_t auth_req = ESP_LE_AUTH_BOND;
  esp_ble_io_cap_t iocap = ESP_IO_CAP_NONE;
  uint8_t key_size = 16;
  uint8_t init_key = ESP_BLE_ENC_KEY_MASK | ESP_BLE_ID_KEY_MASK;
  uint8_t rsp_key  = ESP_BLE_ENC_KEY_MASK | ESP_BLE_ID_KEY_MASK;

  esp_ble_gap_set_security_param(ESP_BLE_SM_AUTHEN_REQ_MODE, &auth_req, sizeof(uint8_t));
  esp_ble_gap_set_security_param(ESP_BLE_SM_IOCAP_MODE, &iocap, sizeof(uint8_t));
  esp_ble_gap_set_security_param(ESP_BLE_SM_MAX_KEY_SIZE, &key_size, sizeof(uint8_t));
  esp_ble_gap_set_security_param(ESP_BLE_SM_SET_INIT_KEY, &init_key, sizeof(uint8_t));
  esp_ble_gap_set_security_param(ESP_BLE_SM_SET_RSP_KEY, &rsp_key, sizeof(uint8_t));

  Serial.println("Seguridad Bluedroid configurada, esperando conexiones...");
}

// ======================= LOOP =======================

void loop() {
  // --- Si ya estamos en modo actualizacion, solo atendemos peticiones web ---
  if (modoOtaActivo) {
    server.handleClient();

    // Salida manual: mantener Boton1+Palanca abajo pulsados 3s reinicia
    // y vuelve al modo Bluetooth normal, sin depender de la web ni del reset fisico
    bool s0 = (digitalRead(PHYSICAL_PINS[0]) == LOW);
    bool s3 = (digitalRead(PHYSICAL_PINS[3]) == LOW);
    if (s0 && s3) {
      if (!salirOtaEnCurso) {
        salirOtaEnCurso = true;
        salirOtaInicio = millis();
      }
      salirOtaUltimoOk = millis();
      if (millis() - salirOtaInicio >= TIEMPO_SALIR_OTA) {
        Serial.println(">>> Saliendo de modo actualizacion (combo), reiniciando... <<<");
        ESP.restart();
      }
    } else if (salirOtaEnCurso && (millis() - salirOtaUltimoOk > TOLERANCIA_COMBO)) {
      salirOtaEnCurso = false;
    }

    // Salida automatica: si nadie se conecta a la red en 10 minutos, reinicia solo
    if (WiFi.softAPgetStationNum() == 0 && (millis() - otaModoInicio) >= TIEMPO_LIMITE_OTA) {
      Serial.println(">>> Nadie conectado tras 10 min, saliendo de modo actualizacion... <<<");
      ESP.restart();
    }

    return;
  }

  bool p[5];
  for (int i = 0; i < 5; i++) p[i] = (digitalRead(PHYSICAL_PINS[i]) == LOW);

  // --- Combo Boton1+Palanca abajo mantenido 5s: entra en modo actualizacion ---
  // (con margen de tolerancia: un pequeño desajuste al pulsar los dos
  // botones, o soltar un instante, no reinicia la cuenta atras)
  if (p[0] && p[3] && !p[4]) {
    if (!comboOtaEnCurso) {
      comboOtaEnCurso = true;
      comboOtaInicio = millis();
    }
    comboOtaUltimoOk = millis();
    if (millis() - comboOtaInicio >= TIEMPO_COMBO) {
      iniciarModoOTA();
      return;
    }
    delay(10);
    return;
  } else if (comboOtaEnCurso) {
    if (millis() - comboOtaUltimoOk > TOLERANCIA_COMBO) {
      comboOtaEnCurso = false;
    } else {
      delay(10);
      return;
    }
  }

  if (!bleKeyboard->isConnected()) {
    delay(10);
    return;
  }

  // --- Combo Boton1+Palanca arriba mantenido 5s: reinicia el mando ---
  if (p[0] && p[4] && !p[3]) {
    if (!comboRebootEnCurso) {
      comboRebootEnCurso = true;
      comboRebootInicio = millis();
    }
    comboRebootUltimoOk = millis();
    if (millis() - comboRebootInicio >= TIEMPO_COMBO) {
      Serial.println(">>> Combo de reinicio detectado, reiniciando... <<<");
      ESP.restart();
    }
    delay(10);
    return;
  } else if (comboRebootEnCurso) {
    if (millis() - comboRebootUltimoOk > TOLERANCIA_COMBO) {
      comboRebootEnCurso = false;
    } else {
      delay(10);
      return;
    }
  }

  static unsigned long ultimoDebug = 0;
  if (millis() - ultimoDebug > 1000) {
    ultimoDebug = millis();
    Serial.printf("Conectado: %d | Pines: %d %d %d %d %d\n",
      bleKeyboard->isConnected(), p[0], p[1], p[2], p[3], p[4]);
  }

  for (int i = 0; i < 5; i++) {
    if (p[i]) {
      Serial.printf(">>> Pulsado fisico %d -> tecla id %d (perfil %d)\n", i, botonKeyId[perfilActivo][i], perfilActivo);
      enviarAccion(botonKeyId[perfilActivo][i]);
    }
  }

  delay(10);
}
